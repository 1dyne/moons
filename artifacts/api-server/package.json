{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:section11": "node ./scripts/run-integration.mjs src/moons/tests/section11.integration.ts",
    "test:product": "node ./scripts/run-integration.mjs src/moons/tests/product.integration.ts",
    "test:sync": "node ./scripts/run-integration.mjs src/moons/tests/sync.integration.ts",
    "test": "node --experimental-strip-types --test src/moons/tests/*.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:life": "node ./scripts/run-integration.mjs src/life/life.integration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@clerk/express": "^2.1.78",
    "@clerk/shared": "^4.40.0",
    "@electric-sql/pglite": "^0.5.9",
    "@google-cloud/storage": "^8.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/moons-sync": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.0",
    "http-proxy-middleware": "^4.2.0",
    "js-tiktoken": "^1.0.21",
    "linkedom": "^0.18.13",
    "multer": "^2.4.0",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "zod": "catalog:",
    "@workspace/life-contract": "workspace:*",
    "@workspace/planner-spec": "workspace:*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
